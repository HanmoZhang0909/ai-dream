{
  "name": "dsh-ai-dream",
  "version": "3.0.5",
  "description": "AI Dream — Artificial Intelligence Driven Real-time Emotional Ambient Medium. 让每个 AI 的感受有形状 / A shape for every feeling. DSH 右侧栏一块连续流动的情绪氛围光。",
  "license": "MIT",
  "author": "HanmoZhang0909",
  "keywords": [
    "ai-dream",
    "dsh-plugin",
    "deepseek-harness",
    "affective-computing",
    "ai",
    "emotion",
    "generative-visual",
    "ambient",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanmoZhang0909/ai-dream.git"
  },
  "homepage": "https://github.com/HanmoZhang0909/ai-dream#readme",
  "bugs": {
    "url": "https://github.com/HanmoZhang0909/ai-dream/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "docs/index.json",
    "docs/demo.html",
    "docs/protocol-v3.schema.json",
    "examples",
    "mcp",
    "renderer",
    "resources",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check client.js && node scripts/check-index.mjs && node scripts/check-renderer-core.mjs && node scripts/check-protocol-v3.mjs && node scripts/check-mcp-manifest.mjs && node scripts/check-mcp-server.mjs && node scripts/check-docs.mjs && node scripts/check-examples.mjs && node scripts/check-config.mjs && node scripts/check-fence-regex.mjs",
    "prepublishOnly": "npm run check"
  }
}
