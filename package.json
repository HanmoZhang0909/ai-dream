{
  "name": "dsh-ai-dream",
  "version": "1.11.2",
  "description": "AI Dream — Artificial Intelligence Driven Real-time Emotional Ambient Medium. 让每个 AI 的感受有形状 / A shape for every feeling. DSH 右侧栏一块连续流动的情绪氛围光。",
  "license": "MIT",
  "author": "HanmoZhang0909",
  "keywords": [
    "ai-dream",
    "dsh-plugin",
    "deepseek-harness",
    "affective-computing",
    "ai",
    "emotion",
    "generative-visual",
    "ambient",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanmoZhang0909/ai-dream.git"
  },
  "homepage": "https://github.com/HanmoZhang0909/ai-dream#readme",
  "bugs": {
    "url": "https://github.com/HanmoZhang0909/ai-dream/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "examples",
    "mcp",
    "renderer",
    "resources",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
