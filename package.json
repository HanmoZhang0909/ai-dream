{
  "name": "dsh-ai-canvas",
  "version": "0.2.0",
  "description": "AI 情感出口：DSH 右侧栏一块连续流动的光，用纯视觉表达 AI 自己的情绪状态。",
  "license": "MIT",
  "author": "HanmoZhang0909",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai",
    "emotion",
    "generative-visual",
    "canvas",
    "ambient"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanmoZhang0909/dsh-ai-canvas.git"
  },
  "homepage": "https://github.com/HanmoZhang0909/dsh-ai-canvas#readme",
  "bugs": {
    "url": "https://github.com/HanmoZhang0909/dsh-ai-canvas/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "examples",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
